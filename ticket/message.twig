<div class="sp-message sp:flex {% if unread %}sp-message-collapsible{% else %}sp-message-collapsed{% endif %}"
     data-id="{{ message.id }}" data-timeline-id="{{ timeline.id }}" data-created-at="{{ message.created_at }}"
     data-type="{{ enum('App\\Modules\\Ticket\\Models\\Enums\\TimelineEntry').Reply.value }}">
    <div class="sp-message-avatar sp:flex-none sp:hidden sp:w-8 sp:pt-1.5 sp:me-3 sp:z-10 sp:md:block sp:xl:w-12 sp:xl:pt-2 sp:xl:-ms-2">
        <img src="{{ message.user.avatar_url }}" class="sp-avatar sp:max-w-8 sp:xl:max-w-12" loading="lazy" />
    </div>

    <div class="sp-message-content sp:grow">
        <div class="sp-message-header">
            <div class="sp-description">
                <span class="sp-name sp:font-bold sp:text-base
                          {% if message.isByOperator() %}sp:text-red-700 sp:dark:text-red-300{% else %}sp:text-green-700 sp:dark:text-green-300{% endif %}">
                    {{ message.user.formatted_name }}
                </span>
                &nbsp;&middot;&nbsp;
                {{ timeago(message.created_at) }}
            </div>
        </div>

        <div class="sp:px-4 sp:py-3 sp:overflow-auto">
            <div class="sp-message-text sp:flow-root">
                <div class="sp-message-text-trimmed {% if unread %}sp:hidden{% endif %}" dir="auto">{{ message.excerpt }}</div>

                <div class="sp-message-text-original {% if message.show_more is empty %}sp-message-text-loaded{% endif %}
                         {% if message.clipped %}sp-message-text-clipped{% endif %} {% if not unread %}sp:hidden{% endif %}" dir="auto">
                    {% if message.show_more is empty %}
                        {{ message.purified_text|raw }}
                    {% endif %}
                </div>
            </div>

            {% if not message.attachments.isEmpty() %}
            <div class="sp:print:hidden">
                <ul class="sp-attachments">
                    {% for attachment in message.attachments %}
                        <li data-download-url="{{ attachment.direct_frontend_url }}" data-filename="{{ attachment.original_name }}">
                            <a class="{% if attachment.upload.isPreviewableVideo() or attachment.upload.isPreviewableAudio() or attachment.upload.isPreviewableImage() %}sp-attachment-preview {% endif %}"
                                    {% if attachment.upload.isPreviewable() %}
                                data-download-url="{{ attachment.direct_frontend_url }}"
                                {% if attachment.upload.isPreviewableVideo() or attachment.upload.isPreviewableAudio() %}
                                    data-video='{"source": [{"src":"{{ attachment.previewFrontendUrl(true) }}", "type":"{{ attachment.upload.mime }}"}], "attributes": {"preload": false, "controls": true}}'
                                {% else %}
                                    href="{{ attachment.previewFrontendUrl(true) }}"
                                    {% if not attachment.upload.isPreviewableImage() %}target="_blank"{% endif %}
                                {% endif %}
                            {% else %}
                                href="{{ attachment.direct_frontend_url }}"
                                    {% endif %}>
                                <div class="sp-attachment-icon">
                                    <div class="fiv-viv fiv-icon-{{ attachment.upload.icon }} sp:text-xl"></div>
                                </div>
                                <div class="sp-attachment-name" data-filename="{{ attachment.original_name }}">
                                    {{ attachment.original_name }}
                                </div>
                                <div class="sp-attachment-size sp-description">{{ attachment.upload.size }}</div>
                            </a>
                            {% if message.isByUser() %}
                                <div class="sp-delete-attachment"
                                     title="{{ Lang.get('general.delete') }}"
                                     data-url="{{ route('ticket.frontend.attachment.destroy') }}"
                                     data-token="{{ Request.input('token', '') }}"
                                     data-attachment-id="{{ attachment.id }}"
                                     data-hash="{{ attachment.upload_hash }}">
                                    <i class="fa-solid fa-times"></i>
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}

                    <li>
                        <button class="sp-download-all sp-button-sm" style="display: none;" title="{{ Lang.get('general.download_all') }}">
                            <i class="fa-solid fa-download sp:text-secondary sp:hover:text-primary"></i>
                            <span class="sp:hidden sp:md:inline">&nbsp;{{ Lang.get('general.download_all') }}</span>
                        </button>
                    </li>
                </ul>
            </div>

            <div class="sp:p-3 sp:xl:px-4 sp:hidden sp:print:block">
                <h4 class="sp:m-0">{{ Lang.choice('general.attachment', 2) }}</h4>

                <ul>
                    {% for attachment in message.attachments %}
                        <li>
                            <a href="{{ attachment.direct_frontend_url }}">{{ attachment.original_name }}</a>
                            <span class="sp-description">({{ attachment.upload.size }})</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </div>
    </div>
</div>
