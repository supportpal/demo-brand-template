<!DOCTYPE html>
<html class="{{ get_template_mode(false) }}" dir="{{ get_template_dir() }}" lang="{{ App.getLocale() }}">

<head>
    {{ View.fireHook('operator.head_start') }}

    <meta name="robots" content="noindex" />
    <meta name="timeline-url-id" content="{{ timelineUrlId }}" />

    <title>{{ ticket.subject }}</title>

    {% include 'frontend.' ~ template ~ '.head_common' %}

    {{ View.fireHook('frontend.head') }}
    {{ View.fireHook('operator.head_end') }}
</head>

<body class="sp:bg-secondary sp:text-primary sp:print:bg-primary" data-disable-pace>

    {{ View.fireHook('frontend.body_start') }}

    <div class="sp:wrap-break-word sp:xs:px-6 sp:print:p-0">
        {{ View.fireHook('frontend.wrapper_start') }}

        <div class="sp:mx-auto sp:mt-6 sp:xs:mb-6">
            {{ View.fireHook('frontend.content_start') }}
            {{ View.fireHook('frontend.content_inner_start') }}

            <h2 class="sp:ms-4 sp:xs:ms-0">{{ ticket.subject }}</h2>

            <div class="sp-collapsible sp:flex sp:mb-1 sp:bg-tertiary sp:rounded-none sp:xs:rounded">
                <h4 class="sp:grow sp:m-0">{{ Lang.get('ticket.ticket_details') }}</h4>
                <div class="sp-chevron sp:ms-3 sp:print:hidden">
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </div>
            </div>

            <div class="sp:px-4 sp:pt-6 sp:py-2 sp:bg-primary sp:xs:px-6 sp:xs:rounded">
                {% include 'frontend.' ~ template ~ '.ticket.ticket_details' %}

                {% if customfields is not empty %}
                    {% include 'frontend.' ~ template ~ '.ticket.ticket_custom_fields' with {'no_save': true} %}
                {% endif %}
            </div>

            <div class="sp-collapsible sp:flex sp:mt-6 sp:mb-1 sp:bg-tertiary sp:rounded-none sp:xs:rounded">
                <h4 class="sp:grow sp:m-0">{{ Lang.choice('general.message', 2) }}</h4>
                <div class="sp-chevron sp:ms-3 sp:print:hidden">
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </div>
            </div>

            <div class="sp-messages-container" data-position="inline">
                <div class="sp-loading sp:p-3 sp:mx-6 sp:bg-secondary sp:rounded sp:text-center">
                    <i class="fa-solid fa-spinner fa-pulse"></i>
                    {{ Lang.get('general.loading') ~ '...'  }}
                </div>
            </div>

            {{ View.fireHook('frontend.content_inner_end') }}
            {{ View.fireHook('frontend.content_end') }}
        </div>

        {{ View.fireHook('frontend.wrapper_end') }}
    </div>

    {{ View.fireHook('operator.footer') }}

    {% include 'frontend.' ~ template ~ '.footer_common' %}

    <!-- WYSIWYG Editor -->
    <script src="{{ asset_rev('resources/assets/libs/editor.min.js') }}"></script>

    <!-- File upload -->
    <script src="{{ asset_rev('resources/assets/dist/fileupload.min.js') }}"></script>

    <!-- Attachment previews -->
    <script src="{{ asset_rev('resources/assets/libs/att.preview/js/att.preview.min.js') }}"></script>

    <!-- Custom fields -->
    <script src="{{ asset_rev('resources/assets/general/js/customfields.js') }}"></script>

    <script src="{{ asset_rev('resources/assets/dist/ticket-view.js') }}"></script>
    <script>
        Swal.showLoading();
        App.extend('FrontendTicketView', new SpTicket.FrontendTicket);
        App.extend('TicketView', new SpTicket.TicketView(
            App.FrontendTicketView,
            "{{ ticket.id }}",
            undefined,
            "{{ ticket.user.isDescendingReplyOrder() ? "DESC" : "ASC" }}"
        ));
        App.TicketView.setPrinting(true);
        App.TicketView.load(function() {
            // After initial messages are loaded, load all collapsed sections and then print
            App.TicketView.loadAllCollapsedSections().always(function() {
                App.FrontendTicketView.print();
            });
        });
    </script>

    <script>
        $(document).ready(function() {
            // Date picker
            $('.datepicker').datepicker();

            // Timepicker
            $('.timepicker').timepicker();

            // Remove the "Mark as Resolved" button from the print view.
            $('.sp-mark-resolved').remove();

            // Hide collapsed section headers in print view.
            $('.sp-collapsible').on('click', function() {
                $(this).toggleClass('sp:print:hidden');
            });
        });
    </script>

    {{ View.fireHook('frontend.body_end') }}

</body>

</html>
